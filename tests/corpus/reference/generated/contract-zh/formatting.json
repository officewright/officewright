6,"font":2,"runs":[[67,2],[1,1]]},{"index":7,"text":"服务期限","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":5,"list_string":"第二条","list_level":1,"font":3,"runs":[[4,3],[1,1]]},{"index":8,"text":"本合同服务期限自2026年4月1日起至2027年3月31日止。期满前三十日内，双方可协商续签。","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":6,"font":2,"runs":[[8,2],[4,1],[1,2],[15,4],[19,2],[1,1]]},{"index":9,"text":"费用及支付方式","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":5,"list_string":"第三条","list_level":1,"font":3,"runs":[[7,3],[1,1]]},{"index":10,"text":"服务费用总额为人民币壹拾贰万元整（¥120,000.00），按季度平均支付。甲方应在每季度首月十日前，将当季费用汇入乙方","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":6,"font":2,"runs":[[17,2],[11,1],[37,2],[1,1]]},{"index":11,"text":"双方权利义务","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":5,"list_string":"第四条","list_level":1,"font":3,"runs":[[6,3],[1,1]]},{"index":12,"text":"甲方应为乙方提供必要的工作条件和系统访问权限；乙方应按照约定的服务标准及时响应，一般故障四小时内处理，重大故障三十分钟内","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":6,"font":2,"runs":[[63,2],[1,1]]},{"index":13,"text":"保密","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":5,"list_string":"第五条","list_level":1,"font":3,"runs":[[2,3],[1,1]]},{"index":14,"text":"双方对在履行本合同过程中知悉的对方商业秘密和技术资料负有保密义务，该义务在本合同终止后两年内继续有效。","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":6,"font":2,"runs":[[51,2],[1,1]]},{"index":15,"text":"违约责任","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":5,"list_string":"第六条","list_level":1,"font":3,"runs":[[4,3],[1,1]]},{"index":16,"text":"任何一方违反本合同约定，应赔偿由此给对方造成的直接经济损失。乙方未按约定响应的，每次按当季服务费的百分之一扣减。","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":6,"font":2,"runs":[[56,2],[1,1]]},{"index":17,"text":"争议解决","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":5,"list_string":"第七条","list_level":1,"font":3,"runs":[[4,3],[1,1]]},{"index":18,"text":"因本合同引起的争议，双方应友好协商解决；协商不成的，任何一方均可向甲方所在地人民法院提起诉讼。","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":6,"font":2,"runs":[[47,2],[1,1]]},{"index":19,"text":"其他","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":5,"list_string":"第八条","list_level":1,"font":3,"runs":[[2,3],[1,1]]},{"index":20,"text":"本合同一式两份，甲乙双方各执一份，自双方签字盖章之日起生效。","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":6,"font":2,"runs":[[30,2],[1,1]]},{"index":21,"text":"","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":7,"font":1,"runs":[[1,1]]},{"index":22,"text":"甲方（盖章）：星河软件有限公司","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":8,"font":2,"runs":[[15,2],[1,1]]},{"index":23,"text":"代表人签字：","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":8,"font":2,"runs":[[6,2],[1,1]]},{"index":24,"text":"日期：2026年3月12日","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":8,"font":2,"runs":[[3,2],[4,1],[1,2],[5,4],[1,1]]},{"index":25,"text":"乙方（盖章）：青松信息技术有限公司","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":8,"font":2,"runs":[[17,2],[1,1]]},{"index":26,"text":"代表人签字：","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":8,"font":2,"runs":[[6,2],[1,1]]},{"index":27,"text":"日期：2026年3月12日","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":8,"font":2,"runs":[[3,2],[4,1],[1,2],[5,4],[1,1]]},{"index":28,"text":"","style_builtin":true,"format":2,"font":1,"runs":[[1,1]]},{"index":29,"text":"","style_builtin":true,"style_id":"Normal","style_name":"Normal","format":2,"font":1,"runs":[[1,1]]}]},{"story":"primary-footer","instance":0,"paragraphs":[{"index":0,"text":"第 1 页 共 2 页","style_builtin":true,"format":9,"font":5,"runs":[[2,5],[1,6],[6,6],[1,6],[1,6],[1,6],[1,6],[4,5],[1,6],[10,6],[1,6],[1,6],[1,6],[1,6],[1,5],[1,1]]}]}]}
