* text=auto eol=lf

# Test documents must stay byte-exact. PDF and RTF can be pure ASCII, so git would
# otherwise treat them as text and normalize their line endings.
*.doc binary
*.docx binary
*.pdf binary
*.png binary
*.ppt binary
*.pptx binary
*.rtf binary
*.xls binary
*.xlsx binary

# Third-party data is kept byte for byte as published (Helvetica.afm has CRLF endings).
crates/officewright-pdf/data/afm/* -text
crates/officewright-layout/data/* -text
tests/fonts/** -text
tests/fonts-word/** -text
tests/corpus/poi/** -text

# Exact bytes matter: the fixture has a CRLF line ending and a form feed.
tests/pdf-output/sample.txt -text

# Fuzz seeds are kept byte for byte: CRLF line ends and UTF-16 are what some of them test.
fuzz/seeds/** -text
